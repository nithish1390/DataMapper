# Copy to .env before running the backend. All LLM calls use the OpenAI SDK
# against an OpenAI-compatible endpoint. Values set in the UI (Settings → LLM API)
# take precedence; these are the defaults when the UI fields are empty.

# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=dummy
# LLM_MODEL=llama3.1

# CORS_ORIGINS=http://localhost:4200
